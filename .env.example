# Copia este archivo a .env (que ya está en .gitignore) para desarrollo local,
# o define estas mismas variables en las "Variables" de Railway en producción.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Postgres en producción. Si no se define, el proyecto sigue usando SQLite
# local (comportamiento actual, sin cambios).
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Producción: dominios reales separados por coma.
ALLOWED_HOSTS=supermotos.com,www.supermotos.com
CORS_ALLOWED_ORIGINS=https://supermotos.com,https://www.supermotos.com
CSRF_ORIGIN=https://supermotos.com
