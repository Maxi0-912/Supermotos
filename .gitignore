# Entorno virtual de Python
.venv/
venv/

# Variables de entorno (nunca subir secretos reales)
.env

# Base de datos local
db.sqlite3
*.sqlite3

# Estáticos recolectados por collectstatic (whitenoise los sirve desde acá
# en producción; no hace falta versionarlos)
staticfiles/

# Bytecode de Python
__pycache__/
*.pyc

# Archivos subidos por usuarios (fotos de productos/motos)
media/

# Excel de inventario de Celeste (datos reales del negocio del cliente)
*.xlsx

# Logs
runserver.log
*.log

# Datos sensibles de demo
CREDENCIALES_DEMO.txt

# Editores / SO
.vscode/
.idea/
.DS_Store
